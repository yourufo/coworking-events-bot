# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env в .gitignore и никогда не попадёт в git-репозиторий —
# так секретный токен бота не "утечёт" никуда наружу.

# Токен бота, выданный @BotFather в Telegram (команда /newbot)
BOT_TOKEN=

# Необязательно: путь к файлу базы данных SQLite.
# Если не задать — по умолчанию используется data/coworking.db
DB_PATH=data/coworking.db
